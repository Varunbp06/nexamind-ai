NEXT_PUBLIC_BACKEND_URL=http://localhost:8682
# Standalone chat mode (OpenAI-compatible provider). Leave empty to use the FastAPI backend.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ─── Auth (NextAuth) ───
NEXTAUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# Google SSO — create OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub SSO — create OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# ─── Security tuning (optional, sane defaults in code) ───
# RATE_LIMIT_CHAT_PER_MIN=30
# RATE_LIMIT_GENERAL_PER_MIN=240
# PROXY_MAX_BODY_BYTES=26214400
